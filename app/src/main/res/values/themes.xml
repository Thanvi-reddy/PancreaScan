<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Pancreatic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.App.Activity</item>
    </style>

    <style name="Theme.Pancreatic" parent="Base.Theme.Pancreatic" />

    <style name="Theme.Pancreatic.NoActionBar" parent="Theme.Pancreatic">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>